         <pdf:Keywords/>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP380 - Fixed/Adjustable Current‚ÄêLimiting Power‚ÄêDistribution Switches</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP380 is a high side power‚Äêdistribution switch designed for applications where heavy capacitive loads and short‚Äêcircuits are likely to be encountered. The device includes an integrated 55 mŒ© (DFN package), P‚Äêchannel MOSFET. The device limits the output current to a desired level by switching into a constant‚Äêcurrent regulation mode when the output load exceeds the current‚Äêlimit threshold or a short is present. The current‚Äêlimit threshold is either user adjustable between 500 mA and 2.1 A via an external resistor or internally fixed. The power‚Äêswitch rise and fall times are controlled to minimize current ringing during switching.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:aceec136-99f4-4993-b68a-57c35a1f9b38</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:d594d98f-5715-4af0-8e31-d08c089205bf</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
